# SafeSpace backend — copy to .env (gitignored).
# The app and practice drills run without provider credentials. Real calls, SMS and
# email fail closed until their complete configuration is present.

PORT=3000

# Use production security headers on an internet-facing deployment.
NODE_ENV=

# Number of trusted reverse-proxy hops in front of Express. Leave blank/0 when direct.
# Set only when the proxy path is known and overwrites X-Forwarded-For; a wrong value can
# make IP-based OTP abuse controls ineffective or group unrelated users together.
TRUST_PROXY_HOPS=

# Seed/demo identity used only for anonymous local practice and the explicitly enabled
# simulation route. Real drills always derive identity from a verified bearer session.
DRILL_USER=you

# ── Public origin, signed links and lifecycle controls ────────────────────
# Exact HTTPS origin, with no path or trailing slash. Vapi calls this origin back, and
# SMS/email action links are pinned to it.
PUBLIC_URL=

# HMAC secret for expiring first-party reveal, report and email-verification links.
# Required for real SMS/email drills. Generate independently:
#   openssl rand -hex 32
DRILL_LINK_SECRET=

# Stable HMAC secret used to reconnect a detached number to its preserved account after
# a fresh OTP. Keep it unchanged across redeploys; generate separately from other keys.
# Required for phone removal. Minimum 32 characters: openssl rand -hex 32
IDENTITY_LOOKUP_SECRET=

# Sessions expire after 30 days by default. Values are milliseconds; minimum 60000.
SESSION_TTL_MS=

# Minimum gap between real drills of the same channel for one user. Default 300000
# (5 minutes); minimum 5000. Enforced atomically, including on Redis.
REAL_DRILL_COOLDOWN_MS=

# ── Vapi voice drill ──────────────────────────────────────────────────────
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=

# Required for the internet-facing end-of-call webhook. Vapi echoes this value in the
# x-vapi-secret header. Generate independently: openssl rand -hex 32
VAPI_WEBHOOK_SECRET=

# Optional voice/model tuning.
VAPI_CLAUDE_MODEL=
VAPI_VOICE_PROVIDER=azure
VAPI_VOICE_ID=en-SG-WayneNeural
MAX_DURATION_SECONDS=300

# Optional ElevenLabs tuning when VAPI_VOICE_PROVIDER=11labs.
VAPI_VOICE_MODEL=
VAPI_VOICE_STABILITY=
VAPI_VOICE_SIMILARITY=
VAPI_VOICE_STYLE=

# ── Twilio phone ownership + SMS drills ──────────────────────────────────
# Account credentials are shared by Verify and Programmable Messaging.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Phone-registration OTP.
TWILIO_VERIFY_SERVICE_SID=

# Durable cap across different destination numbers from one resolved client address.
# Defaults to 20 OTP starts per hour. Enforce an additional limit at the CDN/edge too.
PHONE_VERIFICATION_REQUESTER_MAX_PER_HOUR=

# Real SMS drills require a Messaging Service with an SMS sender in its Sender Pool.
# A standalone TWILIO_SMS_FROM number is not sufficient for Twilio scheduling.
TWILIO_MESSAGING_SERVICE_SID=

# Durable safety reveal delay in milliseconds. Twilio accepts 15 minutes–35 days;
# SafeSpace defaults to 960000 (16 minutes, just above the provider boundary).
SMS_REVEAL_DELAY_MS=

# ── Email ownership + email drills ───────────────────────────────────────
# Google Apps Script relay. OPENAI_API_KEY is intentionally not used: the relay renders
# escaped, allow-listed fictional templates and rejects arbitrary HTML.
GOOGLE_SCRIPT_URL=
GOOGLE_SCRIPT_SECRET=

# Optional origin fallback for signed email/SMS links when PUBLIC_URL is not set.
# Must be an exact HTTPS origin and must match the Apps Script SAFESPACE_LINK_ORIGIN
# property. Live Vapi calls still require PUBLIC_URL.
EMAIL_ACTION_ORIGIN=

# Durable Apps Script safety follow-up delay in milliseconds. Allowed 60000–86400000;
# default 600000 (10 minutes).
EMAIL_SAFETY_FOLLOWUP_DELAY_MS=

# Apps Script also requires these Script Properties (not environment variables):
#   SAFESPACE_SECRET      = the same value as GOOGLE_SCRIPT_SECRET
#   SAFESPACE_LINK_ORIGIN = PUBLIC_URL (or EMAIL_ACTION_ORIGIN)
# Run `_authorise` once in the Apps Script editor before deploying the relay.

# ── Storage backend ──────────────────────────────────────────────────────
# Blank = server/data.json on a persistent local/ECS disk.
# Set BOTH Upstash values on Vercel or another serverless/read-only host.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Test/tool override for the file backend. Normal test suites point this at temporary
# paths and never delete the application's server/data.json.
SAFESPACE_DATA_FILE=

# ── Explicit local-demo switches ─────────────────────────────────────────
# Accept fixed phone OTP 000000. NEVER enable in production.
ALLOW_DEV_VERIFY=

# Register /api/drills/simulate, which writes non-practice results. NEVER enable in
# production.
ENABLE_DEMO_ROUTES=

# Standalone vapi-voice-poc/ only; the main app uses the verified session user's phone.
MY_MOBILE=
