# Copy this file to .env and fill in your values (never commit .env)
BOT_TOKEN=paste_token_from_BotFather_here
APP_URL=https://your-safespace-link.example.com

# Share of drills sent as an image (from your own screenshots in images/).
# 0.0 = text only, 1.0 = always image when images exist. Default 0.5.
POSTER_PROBABILITY=0.5

# Optional: change the trending-scams feed or cadence.
# TRENDING_URL=https://www.scamalert.sg/stories
# TRENDING_INTERVAL_SECONDS=604800

# Live scam simulation (/simulate) — needs an OpenAI key.
OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Automatic broadcasts (off by default) ---------------------------------
# Push a random drill to everyone who has /start'ed, every DRILL_INTERVAL_SECONDS.
# ENABLE_SCHEDULED_DRILLS=1
# DRILL_INTERVAL_SECONDS=21600
# Weekly "trending scams" broadcast scraped from TRENDING_URL.
# ENABLE_TRENDING_ALERTS=1
# Greet anyone who /start'ed but never got the welcome (each chat once, ever).
# WELCOME_ON_STARTUP=1

# --- Server settings --------------------------------------------------------
# Folder for stats.json, known_chats.json etc. The systemd service sets this to
# /var/lib/safespace-bot; leave it unset on a laptop to use this folder.
# BOT_DATA_DIR=/var/lib/safespace-bot
# Pause between chats when broadcasting (Telegram allows ~30 messages/second).
# BROADCAST_PAUSE_SECONDS=0.05
